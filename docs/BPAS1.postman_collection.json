{
  "info": {
    "_postman_id": "bpas1-backend-collection",
    "name": "BPAS1 Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for BPAS1 backend endpoints (clarify, cards, pipeline, planning, audio, clients, projects). Uses {{base_url}} (default http://localhost:4000)."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000"
    },
    {
      "key": "card_id",
      "value": "<replace-with-card-id>"
    },
    {
      "key": "client_id",
      "value": "<replace-with-client-id>"
    },
    {
      "key": "project_id",
      "value": "<replace-with-project-id>"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Owner Login (POST /auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"ownerpass\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Staff Login (POST /auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
